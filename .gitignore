# Corpus is rebuilt by the collectors, not redistributed (mixed third-party licenses)
corpus/

# Local tool binaries and downloads
bin/
tools_dl/

# Python environments and caches
.venv-checkov/
__pycache__/
*.pyc

# Large raw tool output (per-check counts are preserved in results/tool_coverage_matrix.md)
results/tools/checkov_helm.json
results/tools/*.err

# Raw cloned sources (third-party; rebuilt by collectors)
corpus_src/

# Second-rater sealed key + handoff zip: local until the rater returns the
# sheet, then the key is committed with the replication package
results/second_rater/KEY_sealed.csv
results/second_rater/*.zip

# Self-audit sealed key: committed with the replication package now that the
